{
  "name": "world-in-motion",
  "description": "Interactive 3D world explorer with population, inflation-adjusted GDP per capita, life expectancy, and internet usage from World Bank/ITU, animated rankings, and synchronized historical playback.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "data:refresh": "node scripts/refresh-data.mjs",
    "data:population": "node scripts/refresh-population.mjs",
    "check:population": "node scripts/check-population.mjs",
    "check:playback": "node scripts/check-playback.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "globe:land": "node scripts/generate-globe-land.mjs",
    "globe:countries": "node scripts/generate-globe-countries.mjs",
    "data:gdp": "node scripts/refresh-gdp.mjs",
    "check:indicators": "node scripts/check-indicators.mjs",
    "data:exchange": "node scripts/refresh-exchange-rate.mjs",
    "check:rankings": "node scripts/check-rankings.mjs",
    "data:life": "node scripts/refresh-life.mjs",
    "check:life": "node scripts/check-life.mjs",
    "data:internet": "node scripts/refresh-internet.mjs",
    "check:internet": "node scripts/check-internet.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "24.x"
  }
}
